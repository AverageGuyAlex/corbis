# Kopier denne fila til .env for lokal utvikling med `netlify dev`.
# .env er i .gitignore og skal ALDRI committes.
#
# I produksjon legges de samme to variablene inn i Netlify under
# Site configuration → Environment variables.

# Hentes i profilen din på https://kassal.app/api (gratis hobbytier)
KASSAL_TOKEN=

# Passordet du selv velger for å åpne appen. Bruk noe langt.
APP_PASSWORD=
