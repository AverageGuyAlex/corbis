# Kopier denne fila til .env for lokal utvikling med `netlify dev`.
# .env er i .gitignore og skal ALDRI committes.
#
# I produksjon legges den samme variabelen inn i Netlify under
# Project configuration → Environment variables.
#
# Legg den inn FØR første deploy. Endringer i miljøvariabler krever en ny
# deploy for å tre i kraft, og hver deploy koster credits.

# Hentes i profilen din på https://kassal.app/api (gratis hobbytier)
KASSAL_TOKEN=
